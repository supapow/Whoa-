{
  "name": "opencut",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web && cp -r apps/web/dist ./dist",
    "preview": "npm run preview --workspace=apps/web",
    "lint": "node ./apps/web/node_modules/typescript/bin/tsc --noEmit --project apps/web/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10"
  }
}
